DATABASE_URL="file:./dev.db"

# Auth (required for login). Must match the host + port you open in the browser (NextAuth cookies).
# When you run `npm run dev`, the launcher auto-adjusts this if the dev port differs (e.g. :3010).
# Override auto-sync: set NEXTAUTH_URL_STRICT=1
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# TOTP 2FA: required to enable 2FA — 32 bytes, base64-encoded (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_ENCRYPTION_KEY=""

# Admin UI: open /casa-admin or short alias /admin (same console).
# /casa-admin: admin email. Prefer bcrypt hash for the password (no plain password in env).
# Generate hash: node -e "require('bcryptjs').hash('your-strong-password',12).then(console.log)"
ADMIN_EMAIL="casa-admin@local.dev"
ADMIN_PASSWORD_HASH="$2a$12$replace-with-output-from-bcryptjs-hash"

# Legacy only (deprecated): plain admin password — migrate to ADMIN_PASSWORD_HASH and remove this.
# ADMIN_PASSWORD="use-a-long-random-password"

# Set to 1 to omit Strict-Transport-Security (e.g. behind HTTP-only reverse proxy in dev).
# CK_DISABLE_HSTS=1

# Maintenance mode: set to 1 to redirect all public routes to /maintenance (admin + auth still accessible).
# CK_MAINTENANCE=1

# Bank transfer (checkout + emails). Set IBAN and bank name in production (no defaults in repo).
CK_BANK_IBAN=""
CK_BANK_NAME=""
# CK_BANK_BENEFICIARY="Casa Kilicé"
# CK_BANK_SWIFT=""
# CK_BANK_REFERENCE_HINT="Include your Casa Kilicé order ID in the transfer description."

# Transactional & marketing email (Resend — https://resend.com)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Casa Kilicé <orders@yourdomain.com>"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_live_or_test_..."
# Webhook signing secret for `/api/webhooks/stripe` (SaaS credit top-ups + any other handlers you add).
# STRIPE_WEBHOOK_SECRET="whsec_..."

# B2B Skin API SaaS (`/api/v1/skin/analyze`, landing `/skin-api`, admin `/casa-admin/saas`)
# SAAS_CORS_ORIGIN="https://partner-site.com"   # comma-separated allowed origins; omit or * for dev only
# SAAS_CREDITS_PER_ANALYSIS=1
# SAAS_CREDIT_PRICE_CENTS=5   # price per credit in tetri (GEL minor units) for Stripe Checkout
# Optional HMAC for short-lived iframe tokens (`/api/v1/embed-token`). Falls back to SKIN_ENGINE_SECRET if unset.
# SAAS_EMBED_HMAC_SECRET="long-random-string"

# Optional: run vision pipeline on a separate private deployment (microservice). Full URL including path:
# SKIN_ENGINE_URL="https://your-worker.example.com/api/internal/skin-engine/analyze"
# SKIN_ENGINE_SECRET="same-secret-on-worker-and-app"   # sent as X-Skin-Engine-Secret; worker must NOT set SKIN_ENGINE_URL

# Stripe Billing — monthly subscription Price IDs (Dashboard → Products → recurring prices)
# STRIPE_PRICE_BASIC_MONTHLY="price_..."
# STRIPE_PRICE_PREMIUM_MONTHLY="price_..."
# SAAS_BASIC_MONTHLY_SCANS=100
# SAAS_RATE_ANON_RPM=5
# SAAS_RATE_CREDITS_RPM=40
# SAAS_RATE_BASIC_RPM=120
# SAAS_RATE_PREMIUM_RPM=300

# AI skin scan (optional): vision + optional narrative polish
# Pipeline order when a photo is present: Anthropic (if key) → OpenAI → Gemini → heuristic.
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_VISION_MODEL="claude-3-5-sonnet-20241022"
# OPENAI_API_KEY="sk-..."
# OPENAI_VISION_MODEL="gpt-4o-mini"
# OPENAI_TEXT_MODEL="gpt-4o-mini"
# GEMINI_API_KEY=""
# GEMINI_VISION_MODEL="gemini-2.0-flash"

# Google Analytics 4 (optional — enables gtag when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional: canonical site origin for root layout JSON-LD (Organization.url)
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Journal RSS: in `next dev`, feeds are OFF by default (stability). Set to 1 to fetch RSS locally.
# Production fetches unless set to 0.
# CK_JOURNAL_RSS=1

# Local daily backup (`npm run backup:daily`): keeps last N days under backups/daily/
# BACKUP_RETENTION_DAYS=14
# BACKUPS_ROOT="C:/path/to/external-backup-folder"

# --- Rclone → Google Drive / S3 (optional cloud copy after `npm run backup:daily`) ---
# 1) Install rclone: https://rclone.org/downloads/
# 2) In a terminal, run:  rclone config
# 3) Choose: n (New remote)
# 4) Enter a short name for this connection, e.g.  remote_backup  (you will reuse it below)
# 5) Pick your storage type from the list (e.g. Google Drive, or Amazon S3) and finish the
#    prompts (browser OAuth for Drive, or access key/secret for S3 — follow rclone’s wizard)
# 6) Put the SAME name in your real .env (not committed):
#       RCLONE_REMOTE_NAME=remote_backup
#    Optional folder on the remote (default used by the script if unset):
#       RCLONE_REMOTE_PATH=casa-kilice-backups
# The backup script then runs (after local backup + retention cleanup):
#   rclone copy <backups/daily/> <RCLONE_REMOTE_NAME>:<RCLONE_REMOTE_PATH>/ --max-age 24h
# If rclone is missing or the upload fails, only a warning is logged; local backup still succeeds.
# RCLONE_REMOTE_NAME="remote_backup"
# RCLONE_REMOTE_PATH="casa-kilice-backups"
